                        "unique_name": "definition_activity_02UL520EB460712jVpdpY9CJvB9Eg2DqW6Y",
                        "name": "Format DNS Records",
                        "title": "Format DNS Records",
                        "type": "python3.script",
                        "base_type": "activity",
                        "properties": {
                          "action_timeout": 180,
                          "continue_on_failure": false,
                          "display_name": "Format DNS Records",
                          "script": "import sys\nimport json\n\ntry:\n    raw_data = json.loads(sys.argv[1]) if sys.argv[1] else []\nexcept Exception:\n    raw_data = []\n\nif not isinstance(raw_data, list):\n    raw_data = []\n\nif not raw_data:\n    result = \"No Local DNS records found.\"\nelse:\n    table = \"| Name | Type | IP | TTL | Profile ID |\\n\"\n    table += \"| :--- | :--- | :--- | :--- | :--- |\\n\"\n    for record in raw_data:\n        name = record.get('name', 'N/A')\n        type_ = record.get('type', 'N/A')\n        ip = record.get('ip', 'N/A')\n        ttl = record.get('ttl', 'N/A')\n        profile_id = record.get('profileId', 'N/A')\n        table += f\"| {name} | {type_} | {ip} | {ttl} | {profile_id} |\\n\"\n    result = table\n",
                          "script_arguments": [
                            "$activity.definition_activity_02UL520EB3ODN7KwRHUtIHBHmQu6HKYSpyv.output.variable_workflow_02OARCIQ0ENTK4nSOScJZzM5BErmWYmH400$"
                          ],
                          "script_queries": [
                            {
                              "script_query": "result",
                              "script_query_name": "formatted_table",
