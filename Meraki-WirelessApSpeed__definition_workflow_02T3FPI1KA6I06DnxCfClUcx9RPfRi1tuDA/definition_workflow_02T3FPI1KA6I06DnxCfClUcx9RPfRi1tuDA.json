      {
        "unique_name": "definition_activity_02T4IZM5UT63A4lfXjZ9sneMMVQ1lt3Yyoo",
        "name": "Execute Python Script",
        "title": "Execute Python Script",
        "type": "python3.script",
        "base_type": "activity",
        "properties": {
          "action_timeout": 180,
          "continue_on_failure": false,
          "description": "Execute Python Script",
          "display_name": "Execute Python Script",
          "script": "import json\n\nif isinstance('$activity.definition_activity_02T3I9X482MS82FdFoJuSalQvkEHEkLGm6L.output.jsonpath_queries.json_data$', str):\n    data = json.loads('$activity.definition_activity_02T3I9X482MS82FdFoJuSalQvkEHEkLGm6L.output.jsonpath_queries.json_data$')\nelse:\n    data = '$activity.definition_activity_02T3I9X482MS82FdFoJuSalQvkEHEkLGm6L.output.jsonpath_queries.json_data$'\n\nif not isinstance(data, list):\n    data = [data]\n\nresult = []\nfor item in data:\n    ports = item.get('ports', [])\n    if not ports:\n        continue\n    \n    link_speed = ports[0].get('linkNegotiation', {}).get('speed')\n    \n    if link_speed is not None and link_speed \u003c $workflow.definition_workflow_02T3FPI1KA6I06DnxCfClUcx9RPfRi1tuDA.input.variable_workflow_02TFXF018GFQW4UlBTp4B6Fx5iXjGTop29k$:\n        result.append({\n            'name': item.get('name'),\n            'serial': item.get('serial'),\n            'link_negotiation_speed': link_speed\n        })\n\n# Output as JSON array (Cisco can iterate over this directly)\noutput = json.dumps(result)",
          "script_arguments": [],
          "script_queries": [
            {
              "script_query": "output",
              "script_query_name": "output",
              "script_query_type": "array"
            }
          ],
          "skip_execution": false
        },
        "object_type": "definition_activity"
